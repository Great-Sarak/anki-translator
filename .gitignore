__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage

# Regression originals — full-size copyrighted source files used as the local
# high-fidelity baseline, plus their derived live-classifier fixtures. The
# committed stub corpora + golden.json remain the portable CI baseline.
tests/regression/corpora/originals/
tests/regression/responses.originals.json
tests/regression/golden.originals.json

# Runtime state — directories tracked via .gitkeep, contents ignored
queue/*
!queue/.gitkeep
!queue/committed/
queue/committed/*
!queue/committed/.gitkeep
qa/*
!qa/.gitkeep
trimmed/*
!trimmed/.gitkeep
ledger/*
!ledger/.gitkeep
